generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member")
  createdAt    DateTime @default(now())

  projects      Project[]
  ownedTasks    Task[]         @relation("TaskOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  notifications Notification[]
}

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  color       String   @default("blue")
  createdAt   DateTime @default(now())

  tasks Task[]

  @@index([ownerId])
}

model Task {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignee     User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  description  String    @default("")
  category     String    @default("geral")
  priority     String    @default("medium") // low | medium | high
  date         String? // YYYY-MM-DD
  startTime    String? // HH:MM
  endTime      String? // HH:MM
  done         Boolean   @default(false)
  doneAt       DateTime?
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  checklist ChecklistItem[]

  @@index([ownerId])
  @@index([assigneeId])
  @@index([date])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("task") // task | system
  kind      String // done | assigned | reminder | deleted | project | welcome | security
  title     String
  body      String   @default("")
  taskId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
